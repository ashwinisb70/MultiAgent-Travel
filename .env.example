# Database Configuration
DATABASE_URL=postgresql://tripgenie:tripgenie@localhost:5432/tripgenie_db

# Security
SECRET_KEY=your-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
